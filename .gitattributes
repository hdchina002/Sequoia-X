# 统一换行符，避免 Windows 上编辑后提交把 workflow 变成 CRLF。
# workflow 里有 bash heredoc（python - <<'PY'），CRLF 会导致 "here-document
# delimited by end-of-file" 直接报错，所以 *.yml / *.sh / *.py 强制 LF。
* text=auto eol=lf

# 这几类是 Windows 原生脚本，保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.ps1  text eol=crlf

# 二进制：不做任何换行转换
*.db   binary
*.gz   binary
*.png  binary
*.jpg  binary
